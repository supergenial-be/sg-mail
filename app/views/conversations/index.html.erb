<% box_label = @archived ? "Archivés" : @stack ? ConversationState::STACK_LABELS.fetch(@stack) : Screening::BUCKET_LABELS.fetch(@box) %>
<% box = (@box unless @box == "imbox" || @stack || @archived) %>
<% stack = @stack %>
<% content_for :title, "#{[ box_label, @mailbox&.display_name ].compact.join(" · ")} · #{current_account.name} · SG Mail" %>
<div class="space-top">
<header class="space-head">
  <h1><%= box_label %><%= tag.span(" · #{@mailbox.display_name}", class: "muted", title: @mailbox.address) if @mailbox %></h1>
  <p class="tagline"><%= space_tagline(@archived ? "archived" : @stack || @box) %></p>
</header>

<% active_filters = [ @mailbox, params[:mine] == "1", params[:unread] == "1" ].count(&:itself) %>
<div class="filter-bar<%= " open" if active_filters.positive? %>" data-controller="toggle">
  <button type="button" class="filter-toggle" data-toggle-target="button" data-action="toggle#toggle" aria-expanded="<%= active_filters.positive? %>" aria-controls="filters">
    Filtrer<%= tag.span(active_filters, class: "filter-count") if active_filters.positive? %>
  </button>
  <div class="actions filters" id="filters">
    <% if @mailboxes.many? || @mailbox %>
      <%= form_with url: conversations_path, method: :get, class: "inline" do |f| %>
        <%= f.hidden_field :box, value: box if box %>
        <%= f.hidden_field :stack, value: stack if stack %>
        <%= f.hidden_field :archived, value: "1" if @archived %>
        <%= f.select :mailbox_id, [ [ "Toutes les boîtes", "" ] ] + mailbox_options(@mailboxes),
              { selected: @mailbox&.id }, onchange: "this.form.requestSubmit()", aria: { label: "Boîte" } %>
        <%= f.hidden_field :unread, value: params[:unread] if params[:unread].present? %>
      <% end %>
    <% end %>
    <% if params[:mine] == "1" %>
      <%= link_to "Tous les fils", conversations_path(box: box, stack: stack, mailbox_id: @mailbox&.id) %>
    <% else %>
      <%= link_to "Assignés à moi", conversations_path(box: box, stack: stack, mailbox_id: @mailbox&.id, mine: 1) %>
    <% end %>
    <% if params[:unread] == "1" %>
      <%= link_to "Tous les fils", conversations_path(box: box, stack: stack, mailbox_id: @mailbox&.id) %>
    <% else %>
      <%= link_to "Non lus seulement", conversations_path(box: box, stack: stack, mailbox_id: @mailbox&.id, unread: 1) %>
    <% end %>
    <%= button_to "Tout marquer comme lu", mark_all_read_conversations_path(box: box, stack: stack, mailbox_id: @mailbox&.id), class: "link",
          form: { data: { turbo_confirm: "Marquer comme lus tous les messages#{" de #{@mailbox.display_name}" if @mailbox} ?" } } %>
  </div>
</div>
</div>

<% if @stack == "reply_later" && @conversations.any? %>
  <p class="focus-start"><%= link_to "Répondre à la suite →", focus_reply_path, class: "focus-start-link", data: { shortcut: "R" } %>
    <span class="muted">tous ces fils sur une page, une réponse après l'autre</span></p>
<% end %>

<% if @stack_counts&.values&.any?(&:positive?) %>
  <p class="stacks">
    <% @stack_counts.each do |name, count| %>
      <% next if count.zero? %>
      <%= link_to "#{ConversationState::STACK_LABELS.fetch(name)} (#{count})", conversations_path(stack: name) %>
    <% end %>
  </p>
<% end %>

<% if @mailboxes.none? %>
  <%= render "shared/empty", line: "Tout commence par une boîte." do %><%= link_to "Connecte une boîte", mailboxes_path %> pour recevoir ton courrier ici.<% end %>
<% elsif @conversations.none? && Array(@assigned).none? %>
  <%= render "shared/empty", line: space_empty_line(@archived ? "archived" : @stack || @box) %>
<% end %>

<% if @conversations.any? || Array(@assigned).any? %>
  <%= form_with url: bulk_conversations_path, id: "bulk", class: "bulk", data: { action: "submit->shortcuts#leave" } do |f| %>
    <span class="muted">Les fils cochés :</span>
    <% unless @archived %><%= f.button "Archiver", name: "operation", value: "archive", class: "link", data: { shortcut: "e", shortcut_bulk: true } %><% end %>
    <% if @archived %><%= f.button "Remettre dans la réception", name: "operation", value: "unarchive", class: "link" %><% end %>
    <%= f.button "Marquer comme lus", name: "operation", value: "read", class: "link", data: { shortcut: "I", shortcut_bulk: true } %>
    <%= f.button "Marquer comme non lus", name: "operation", value: "unread", class: "link", data: { shortcut: "U", shortcut_bulk: true } %>
    <% unless @stack %>
      <%= f.button "Répondre plus tard", name: "operation", value: "reply_later", class: "link", data: { shortcut: "l", shortcut_bulk: true } %>
      <%= f.button "Mettre de côté", name: "operation", value: "set_aside", class: "link", data: { shortcut: "s", shortcut_bulk: true } %>
    <% end %>
  <% end %>
<% end %>

<%# Dans la réception, comme chez Hey : ce qui est nouveau pour moi d'abord, puis ce que j'ai déjà vu.
    Au-dessus, les fils qu'on m'a assignés, tant que je ne les ai pas archivés. %>
<% assigned = Array(@assigned) %>
<% sections = if @box == "imbox" && !@stack && !@archived && params[:unread] != "1"
     fresh, seen = @conversations.partition(&:unread_anywhere?)
     [ [ ("Assignés à moi" if assigned.any?), assigned, "assigned" ], [ ("Nouveaux messages" if fresh.any?), fresh, "fresh" ],
       [ ("Déjà vu" if fresh.any? || assigned.any?), seen, "seen" ] ]
   else
     [ [ nil, @conversations, nil ] ]
   end %>
<div data-controller="viewer">
  <% sections.each do |heading, conversations, kind| %>
    <% if kind == "fresh" && conversations.none? && @conversations.any? && params[:before].blank? %>
      <p class="list-section-note">Rien de nouveau depuis ta dernière visite.</p>
    <% end %>
    <% next if conversations.none? %>
    <%= tag.h2(heading, class: [ "list-section", kind ]) if heading %>
    <table class="conversations<%= " seen" if kind == "seen" && heading %>">
      <% conversations.each do |conversation| %>
        <%= render conversation, show_mailbox: !(@mailbox || @mailboxes.one?), selectable: true, swipe: (@stack ? :archive : :both unless @archived) %>
      <% end %>
    </table>
  <% end %>
  <%= render "attachments/viewer" if @conversations.any? || Array(@assigned).any? %>
</div>

<% if @conversations.size == ConversationsController::PER_PAGE && @conversations.last.last_message_at %>
  <p><%= link_to "Plus anciens →", conversations_path(box: box, stack: stack, archived: ("1" if @archived), mailbox_id: @mailbox&.id, unread: params[:unread].presence, before: @conversations.last.last_message_at.iso8601(6)) %></p>
<% end %>
<% unless @archived %>
  <p class="list-foot"><%= link_to "Voir mes fils archivés", conversations_path(archived: 1, mailbox_id: @mailbox&.id) %></p>
<% end %>
